# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed.

# Path to the extracted Google Keep Takeout folder
KEEP_TAKEOUT_DIR=/Users/ericgan/Takeout/keep/

# Secret token that grants write access (CRUD) to the app.
# Set this to a long random string. Use it as ?key=<secret> in the URL
# or via the X-Owner-Token header.
OWNER_SECRET=your-secret-token-here

# Cloud Postgres connection string (auto-set by Render, leave blank locally).
# Locally, the app uses the hardcoded localhost DB_CONFIG in main.py.
DATABASE_URL=
